## @file
#  ResetSystemLib for Apple silicon that reboots through the SoC watchdog.
#
#  m1n1 hands the firmware over at EL2 with nothing underneath it, so the PSCI
#  SYSTEM_RESET SMC/HVC of ArmPsciResetSystemLib has no one to talk to and
#  faults. The watchdog reset is what m1n1 itself uses (wdt_reboot()).
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent OR MIT
##

[Defines]
  INF_VERSION                    = 1.29
  BASE_NAME                      = AppleWdtResetSystemLib
  FILE_GUID                      = 6d1f0b1e-3c5a-4b8e-9f2d-7a4c0e9b5d21
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = HwResetSystemLib

[Sources]
  AppleWdtResetSystemLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  AppleSiliconPkg/AppleSiliconPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  IoLib
  PcdLib

[Pcd]
  gAppleSiliconPkgTokenSpaceGuid.PcdAppleWdtBase   ## CONSUMES
